# Local inference app only
# ------------------------
# Keep this .env on the laptop/edge device that runs OpenCV + PyTorch.
# Do NOT put the Neon, Twilio, or Sarvam secrets in this file.

# Input video source. `file` is the recommended low-cost mode.
CAMERA_SOURCE_TYPE=file
CAMERA_SOURCE=tests/fixtures/sample.mp4
CAMERA_ID=camera-1
INCIDENT_LOCATION=Main Road, test site
# Process uploaded files at their native FPS and stop at the end. This avoids
# repeated alert bursts from a short clip being decoded as fast as possible.
FILE_LOOP=false
FILE_REALTIME=true

# Inference configuration. The 32-frame buffer still supplies 8-frame clips,
# while using much less RAM than the old 128-frame default.
INFERENCE_INTERVAL_MS=1000
CLIP_FRAME_COUNT=8
FRAME_BUFFER_MAXLEN=32

# Frames are downscaled once at ingest to the shorter side the training
# transform resizes to anyway, so the ring buffer holds far less at 720p/1080p
# without changing the tensor the models receive.
INFERENCE_FRAME_SIZE=256
# true  = PIL BICUBIC, bit-identical to the training transform (default).
# false = cv2 INTER_AREA, faster but not identical. Only switch after running
#         scripts/check_preprocess_equivalence.py on your own clips.
INGEST_RESIZE_EXACT=true
# Frames per second pushed into the inference buffer. 0 (default) keeps every
# decoded frame, so the sampled clip matches the pre-optimization behaviour
# exactly. Raising it widens the clip's temporal span — a Phase 3 / B7 tuning
# decision; leave at 0 until then.
INGEST_SAMPLE_FPS=0

# Torch intra-op thread count, applied once at model load. 0 (default) keeps
# torch's own default (one thread per core), which oversubscribes when both
# models and the web server share the machine. Try 4 on an edge box.
TORCH_NUM_THREADS=0
# Batched cv2 clip preprocessing instead of per-frame PIL. Off by default
# (byte-identical to the training transform). Only enable after
# scripts/check_preprocess_equivalence.py reports the fast path is within
# tolerance on your clips.
CLIP_PREPROCESS_FAST=false

# Per-model clip sampling window, in seconds. 0 (default) = the old behaviour:
# the clip is the last CLIP_FRAME_COUNT consecutive frames (~0.3s tail of the
# interval). A positive value spreads those frames across the trailing N
# seconds instead, matching how the models were trained and covering the whole
# interval. Detection is byte-identical until you set a value. The two models
# may differ; violence is the one trained on real temporal spread, so try
# widening it first (e.g. VIOLENCE_CLIP_WINDOW_SEC=1.0). A window wider than
# FRAME_BUFFER_MAXLEN frames of history is clamped to what is buffered.
ACCIDENT_CLIP_WINDOW_SEC=0
VIOLENCE_CLIP_WINDOW_SEC=0

# Phone browser live source (open /phone on the phone; WS /ws/ingest).
# NOTE: getUserMedia needs a secure context. http://localhost qualifies,
# http://<laptop-ip>:8000 from a phone does NOT — front the local app with an
# HTTPS tunnel (cloudflared/ngrok). The page detects this and says so.
# The first four are sent to the browser, which encodes frames itself.
PHONE_SEND_FPS=5
PHONE_FRAME_MAX_WIDTH=480
PHONE_JPEG_QUALITY=0.7
PHONE_AUDIO_CHUNK_MS=1000
# Server-side bounds; these hold no matter what the client does.
PHONE_FRAME_QUEUE_MAX=4
PHONE_AUDIO_BUFFER_MAX=8
PHONE_MAX_MESSAGE_BYTES=1048576
PHONE_MAX_SESSIONS=1

# Browser preview only — no model sees these pixels. Encoded once per new frame
# and shared by every connected client.
PREVIEW_FPS=10
PREVIEW_MAX_WIDTH=640
PREVIEW_JPEG_QUALITY=80

# A verified event needs repeated positive predictions before it is sent.
ACCIDENT_CONFIDENCE_THRESHOLD=0.6
ACCIDENT_MIN_HITS=3
ACCIDENT_WINDOW_SEC=3.0
ACCIDENT_COOLDOWN_SEC=30

VIOLENCE_CONFIDENCE_THRESHOLD=0.6
VIOLENCE_MIN_HITS=2
VIOLENCE_WINDOW_SEC=3.0
VIOLENCE_COOLDOWN_SEC=20

ACCIDENT_MODEL_WEIGHTS_PATH=models/accident_best.pt
VIOLENCE_MODEL_WEIGHTS_PATH=models/violence_best.pt

# Event delivery
# `log-only` prints verified events locally; `remote` sends them to the hosted
# alert_backend, which owns Neon, Sarvam TTS, and Twilio.
EMERGENCY_MODE=log-only
# Set this to the deployed alert backend URL after it is live, no trailing slash.
ALERT_BACKEND_URL=https://YOUR-ALERT-BACKEND.onrender.com
# Use the exact same long random value as alert_backend's ALERT_INGEST_TOKEN.
# This is a shared secret; never commit the real value.
ALERT_BACKEND_TOKEN=
# Seconds between background refreshes of the active incident's status while a
# call is in progress. /api/status serves the cached value, so this only trades
# freshness against request volume to the hosted backend.
INCIDENT_POLL_INTERVAL_SEC=3.0

# Temporary local video uploads. This folder is ignored by git.
VIDEO_UPLOAD_DIR=data/uploads
