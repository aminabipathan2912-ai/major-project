# Camera
CAMERA_SOURCE_TYPE=file
CAMERA_SOURCE=tests/fixtures/sample.mp4
CAMERA_ID=camera-1
INCIDENT_LOCATION=Main Road, test site

INFERENCE_INTERVAL_MS=1000
CLIP_FRAME_COUNT=8

ACCIDENT_CONFIDENCE_THRESHOLD=0.6
ACCIDENT_MIN_HITS=3
ACCIDENT_WINDOW_SEC=3.0
ACCIDENT_COOLDOWN_SEC=30

VIOLENCE_CONFIDENCE_THRESHOLD=0.6
VIOLENCE_MIN_HITS=2
VIOLENCE_WINDOW_SEC=3.0
VIOLENCE_COOLDOWN_SEC=20

ACCIDENT_MODEL_WEIGHTS_PATH=models/accident_best.pt
VIOLENCE_MODEL_WEIGHTS_PATH=models/violence_best.pt

# log-only until keys + public URL are set, then: voice
EMERGENCY_MODE=voice

# Public HTTPS origin of THIS FastAPI backend (no trailing slash).
# Twilio's servers call your backend for TwiML, audio, and "Done" speech.
# This is not a separate frontend URL.
PUBLIC_BASE_URL=https://YOUR-APP.onrender.com

# Twilio: one from-number (Twilio) and one to-number (your phone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
TWILIO_CALL_RETRY_MAX=2

# Sarvam TTS (Bulbul)
SARVAM_API_KEY=
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_LANGUAGE_CODE=en-IN
SARVAM_SPEAKER=shubh
SARVAM_MODEL=bulbul:v3

INCIDENT_DB_PATH=data/incidents.db
INCIDENT_AUDIO_DIR=data/audio
VIDEO_UPLOAD_DIR=data/uploads
