# Local inference app only
# ------------------------
# Keep this .env on the laptop/edge device that runs OpenCV + PyTorch.
# Do NOT put the Neon, Twilio, or Sarvam secrets in this file.

# Input video source. `file` is the recommended low-cost mode.
CAMERA_SOURCE_TYPE=file
CAMERA_SOURCE=tests/fixtures/sample.mp4
CAMERA_ID=camera-1
INCIDENT_LOCATION=Main Road, test site
# Process uploaded files at their native FPS and stop at the end. This avoids
# repeated alert bursts from a short clip being decoded as fast as possible.
FILE_LOOP=false
FILE_REALTIME=true

# Inference configuration. The 32-frame buffer still supplies 8-frame clips,
# while using much less RAM than the old 128-frame default.
INFERENCE_INTERVAL_MS=1000
CLIP_FRAME_COUNT=8
FRAME_BUFFER_MAXLEN=32

# A verified event needs repeated positive predictions before it is sent.
ACCIDENT_CONFIDENCE_THRESHOLD=0.6
ACCIDENT_MIN_HITS=3
ACCIDENT_WINDOW_SEC=3.0
ACCIDENT_COOLDOWN_SEC=30

VIOLENCE_CONFIDENCE_THRESHOLD=0.6
VIOLENCE_MIN_HITS=2
VIOLENCE_WINDOW_SEC=3.0
VIOLENCE_COOLDOWN_SEC=20

ACCIDENT_MODEL_WEIGHTS_PATH=models/accident_best.pt
VIOLENCE_MODEL_WEIGHTS_PATH=models/violence_best.pt

# Event delivery
# `log-only` prints verified events locally; `remote` sends them to the hosted
# alert_backend, which owns Neon, Sarvam TTS, and Twilio.
EMERGENCY_MODE=log-only
# Set this to the deployed alert backend URL after it is live, no trailing slash.
ALERT_BACKEND_URL=https://YOUR-ALERT-BACKEND.onrender.com
# Use the exact same long random value as alert_backend's ALERT_INGEST_TOKEN.
# This is a shared secret; never commit the real value.
ALERT_BACKEND_TOKEN=

# Temporary local video uploads. This folder is ignored by git.
VIDEO_UPLOAD_DIR=data/uploads
