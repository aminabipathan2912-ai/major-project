# Camera source
# Recommended for development/cost: file (pre-recorded video).
# Also supported later: webcam | rtsp
CAMERA_SOURCE_TYPE=file
# For file: local video path. For webcam: index (e.g. 0). For rtsp: rtsp:// URL.
CAMERA_SOURCE=tests/fixtures/sample.mp4
CAMERA_ID=camera-1

# Pipeline / inference cadence
INFERENCE_INTERVAL_MS=1000
# How many buffered frames to send to a model adapter (temporal clip).
CLIP_FRAME_COUNT=8

# Accident verification (temporal/event verification, independent from model)
ACCIDENT_CONFIDENCE_THRESHOLD=0.6
ACCIDENT_MIN_HITS=3
ACCIDENT_WINDOW_SEC=3.0
ACCIDENT_COOLDOWN_SEC=30

# Violence verification
VIOLENCE_CONFIDENCE_THRESHOLD=0.6
VIOLENCE_MIN_HITS=2
VIOLENCE_WINDOW_SEC=3.0
VIOLENCE_COOLDOWN_SEC=20

# Emergency integration (future provider)
# When no provider is configured, verified events are logged only.
EMERGENCY_MODE=log-only

# Trained weights from Kaggle notebooks
ACCIDENT_MODEL_WEIGHTS_PATH=models/accident_best.pt
VIOLENCE_MODEL_WEIGHTS_PATH=models/violence_best.pt
