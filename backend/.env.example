# ============================================================
# Live Multimodal Monitoring System — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Database ---
# SQLite (Phase 1 default)
DATABASE_URL=sqlite+aiosqlite:///./data/monitoring.db
DATABASE_SYNC_URL=sqlite:///./data/monitoring.db

# PostgreSQL (Phase 12 production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/monitoring_db
# DATABASE_SYNC_URL=postgresql://user:password@localhost:5432/monitoring_db

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# --- Secret ---
SECRET_KEY=change-me-in-production-use-a-long-random-string

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO

# --- Data Retention ---
DATA_RETENTION_DAYS=30

# --- Demo Mode ---
DEMO_MODE=true
