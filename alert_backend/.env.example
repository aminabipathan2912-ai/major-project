# Hosted alert backend only
# -------------------------
# Configure these variables in Render's Environment dashboard. Do not commit a
# real .env file. This service does not load video, OpenCV, PyTorch, or weights.

# Neon/PostgreSQL connection string. Keep sslmode=require for Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Must exactly equal the local inference app's ALERT_BACKEND_TOKEN. It prevents
# unknown clients from creating an incident or triggering a phone call.
ALERT_INGEST_TOKEN=replace-with-a-long-random-secret

# This Render service's public HTTPS URL, with no trailing slash. Twilio uses it
# to fetch call instructions/audio and post acknowledgement/status webhooks.
PUBLIC_BASE_URL=https://YOUR-ALERT-BACKEND.onrender.com

# Twilio Programmable Voice. FROM is your Twilio number; TO is your verified
# test/operator mobile number in E.164 format (for example +91...).
# Do not use official emergency-service numbers for this demo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
# `trial-template` plays Twilio's hosted sample message. `trial-custom` uses
# this app's TwiML endpoint to speak/play the alert and accept a spoken "Done"
# acknowledgement, but does not receive call-progress callbacks. Use `custom`
# after upgrading for the complete callback flow.
TWILIO_CALL_MODE=custom
TWILIO_TRIAL_TEMPLATE_URL=https://webhooks.twilio.com/v1/Voice/Template/voice_speech_recognition
# Maximum time an unanswered incident prevents another call from this camera.
ACTIVE_INCIDENT_TIMEOUT_SEC=120

# Sarvam Bulbul TTS. If the API key is blank, Twilio uses its text-to-speech
# fallback alert instead of generated Sarvam audio.
SARVAM_API_KEY=
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_LANGUAGE_CODE=en-IN
SARVAM_SPEAKER=shubh
SARVAM_MODEL=bulbul:v3

# Keep true on Render. It verifies that Twilio webhook requests are authentic.
TWILIO_VALIDATE_WEBHOOKS=true
